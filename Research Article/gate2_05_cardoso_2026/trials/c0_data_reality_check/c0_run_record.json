        ],
        "Series_overall_design": [
          "At 2 weeks post three doses of tamoxifen induction (0.2 mg/gbw) every other day, lung tissues were collected and stromal cells (1:1 mixture of immune cells (CD45+) and both endothelial and mesenchyme cells (CD45\u2013EpCAM\u2013)) were isolated from Sftpc-CreERT2; Confetti and Sftpc-CreERT2; Red2Kras mice. Cells from three mice of the same genotype were pooled into a single cell suspension to generate two separate libraries (1 x Confetti and 1 x Red2Kras). Libraries were generated as described above and sequenced using the Illumina NovaSeq 6000."
        ],
        "Series_platform_id": [
          "GPL24247"
        ]
      },
      "GSE316244": {
        "Series_title": [
          "Early fibrotic niches establish tumour-permissive microenvironments [Experiment 3]"
        ],
        "Series_status": [
          "Public on Feb 24 2026"
        ],
        "Series_pubmed_id": [
          "42020743"
        ],
        "Series_overall_design": [
          "At 2 weeks post two doses of tamoxifen induction (0.2 mg/gbw) every other day, lung tissues were collected from Sftpc-CreERT2; Red2Kras; Aregflox/+ and Sftpc-CreERT2; Red2Kras; Aregflox/flox animals. Lungs from three mice of the same genotype were dissociated and pooled into a single-cell suspension. Lineage-labelled epithelial cells (EpCAM+RFP+) and a mixed population of mesenchymal and immune cells (1:1 ratio of mesenchymal cells (CD45\u2013CD31\u2013EpCAM\u2013) and immune cells (CD45+CD31\u2013EpCAM\u2013)) were then sorted. For each genotype, two separate libraries were generated, resulting in a total of four libraries (2 x Aregflox/+ and 2 x Aregflox/flox). Libraries were sequenced using Illumina Novaseq 6000."
        ],
        "Series_platform_id": [
          "GPL24247"
        ]
      },
