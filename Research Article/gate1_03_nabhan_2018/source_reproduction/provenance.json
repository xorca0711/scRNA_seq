  "series_metadata": {
    "Series_title": [
      "High throughput quantitative whole transcriptome analysis of adult mouse distal lung mesenchyme"
    ],
    "Series_geo_accession": [
      "GSE109444"
    ],
    "Series_status": [
      "Public on Feb 19 2018"
    ],
